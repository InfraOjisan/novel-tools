{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "bash": {
      "*": "ask",
      "python3 tools/novelctl.py *": "allow",
      "nohup python3 tools/novelctl.py *": "allow",
      "tail *": "allow",
      "cat work/*": "allow",
      "cat output/final_report.md": "allow"
    }
  }
}
